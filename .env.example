# Copy to .env and fill in the values (they are shared privately, not committed).
#   cp .env.example .env
#
# Generate your own with:  openssl rand -base64 48

# PostgreSQL password (used by both the db container and the backend)
DB_PASSWORD=

# Base64-encoded HMAC key, at least 256 bits (32 bytes)
JWT_SECRET=

# Accounts created on first start
SEED_ADMIN_EMAIL=admin@pesira.com
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=user@pesira.com
SEED_USER_PASSWORD=
